{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "ES2024.Promise"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "esModuleInterop": true
  },
  "include": ["*.ts"]
}
