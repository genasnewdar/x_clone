# Copy to .env (chmod 600) on the VM. Generate secrets with: openssl rand -base64 36
# Your domain. No domain? Use sslip.io: for VM IP 34.12.56.78 use 34-12-56-78.sslip.io
DOMAIN=example.com
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me-too
# Leave empty to disable admin endpoints entirely. At least 32 chars.
ADMIN_TOKEN=
POW_DIFFICULTY=20
